/**
 * OMNIVEX OS PRIME
 *
 * AURIN GOVERNANCE CORE
 *
 * Authority:
 *
 * ELOHIM DECISION
 *        |
 *        v
 * AURIN GOVERNANCE
 *        |
 *        v
 * AEGIS RISK
 *
 * AURIN NEVER EXECUTES.
 */


const eventBus =
    require("../eventBus");



class AurinCore {


    constructor(){

        this.state = {

            mode:
                process.env.ENABLE_LIVE_TRADING === "true"
                ? "LIVE"
                : "PAPER",


            executionsApproved:
                0,


            executionsBlocked:
                0,


            lastDecision:
                null

        };


        this.initialized =
            false;

    }



    init(){

        if(this.initialized){
            return;
        }


        this.initialized =
            true;


        this.bindEvents();



        console.log(
            "[AURIN ONLINE]"
        );

    }




    bindEvents(){


        eventBus.subscribe(

            "elohim.decision",

            event => {

                this.evaluate(
                    event.data
                );

            }

        );



        eventBus.subscribe(

            "sophia.strategy",

            event => {

                this.handleStrategy(
                    event.data
                );

            }

        );


    }





    evaluate(decision){


        if(!decision){

            return;

        }



        const approval = {


            action:
                decision.action,


            confidence:
                decision.confidence || 0,


            symbol:
                decision.symbol || "BTC",


            source:
                "AURIN",


            timestamp:
                Date.now(),


            decision

        };



        this.state.lastDecision =
            approval;



        if(
            ![
                "BUY",
                "SELL"
            ].includes(
                approval.action
            )
        ){

            return this.block(

                approval,

                "INVALID_ACTION"

            );

        }




        if(
            approval.confidence < 0.65
        ){

            return this.block(

                approval,

                "LOW_CONFIDENCE"

            );

        }




        if(
            this.state.mode !== "LIVE"
        ){

            return this.block(

                approval,

                "PAPER_MODE"

            );

        }




        this.state.executionsApproved++;



        console.log(

            "[AURIN APPROVED]",

            approval.action,

            approval.confidence

        );



        eventBus.publish(

            "aurin.execution.approved",

            approval

        );



        return approval;


    }




    block(execution, reason){


        this.state.executionsBlocked++;



        const rejection = {


            type:
                "aurin.execution.blocked",


            reason,


            execution,


            timestamp:
                Date.now()

        };



        console.log(

            "[AURIN BLOCKED]",

            reason

        );



        eventBus.publish(

            "aurin.execution.blocked",

            rejection

        );



        return rejection;

    }





    status(){

        return this.state;

    }


}



module.exports =
    new AurinCore();
