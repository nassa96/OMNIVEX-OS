generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarketTick {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  volume    Float
  createdAt DateTime @default(now())
}

model Position {
  id        String   @id @default(cuid())
  symbol    String
  entry     Float
  pnl       Float
  status    String
  createdAt DateTime @default(now())
}

model EventLog {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  createdAt DateTime @default(now())
}
