# ================================
# OMNIVEX-OS / SAINT_PRIMAL
# Git Ignore Configuration
# ================================

# Dependencies
node_modules/

# Environment variables (NEVER COMMIT SECRETS)
.env
.env.*
.env.local

# Build outputs
dist/
build/
out/
coverage/

# Cache / runtime artifacts
.cache/
.vite/
.next/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / system files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/

# Optional local runtime state
*.pid
*.seed
*.pid.lock
